# {{ ansible_managed }}
[Unit]
Description=The desktop's way in from Cloudflare Access: the web app, agent API and noVNC (front-door)
Wants=network-online.target novnc.service agentd.service
After=network-online.target novnc.service agentd.service
# Until the customer has set its parameters, it keeps trying.
StartLimitIntervalSec=0

[Service]
User=front-door
Group=front-door
RuntimeDirectory=front-door
RuntimeDirectoryMode=0750
# Its Access settings, from this desktop's own SSM path at each start (as
# root: only root reaches the instance role).
ExecStartPre=+/usr/local/sbin/front-door-settings front-door --path {{ front_door_parameters }} --region {{ front_door_region }}
ExecStart=/usr/local/bin/front-door -config /run/front-door/access.json -listen {{ front_door_listen }} -novnc {{ front_door_novnc }} -agentd {{ front_door_agentd_socket }} -web {{ web_app_dir }}
Restart=always
RestartSec=15
# It only needs the network (Access's signing keys), its socket and agentd's.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=-/run/agentd
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
