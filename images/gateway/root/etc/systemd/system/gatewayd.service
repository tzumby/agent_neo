[Unit]
Description=gatewayd: the attested model gateway
Wants=network-online.target
After=network-online.target nftables.service

[Service]
User=gatewayd
Group=gatewayd
SupplementaryGroups=tss
ExecStart=/usr/local/bin/gatewayd
Restart=always
RestartSec=2
# Scratch space for attestation requests, in memory.
RuntimeDirectory=gatewayd
RuntimeDirectoryMode=0700
# Its log lines (metadata only: never prompts or answers) also go to the
# serial console, the one read-only window into this instance:
# aws ec2 get-console-output.
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
