# {{ ansible_managed }}
LISTEN=unix:/run/agentd/agentd.sock
MODEL={{ agentd_model }}
CDP_URL=http://127.0.0.1:9222
STATE_DIR=/var/lib/agentd
WORKDIR={{ agentd_workdir }}
RUN_AS={{ agentd_shell_user }}
POLICY=/etc/agentd/policy.toml
# The supervisor's checks on running tasks: no cap on steps.
REVIEW_EVERY_SECS={{ (agentd_review_every_minutes | int) * 60 }}
REVIEW_EVERY_STEPS={{ agentd_review_every_steps }}
# Notifications: the contact in each push's VAPID token.
VAPID_SUBJECT={{ agentd_push_contact }}
SHELL_TOOL={{ agentd_shell_tool }}
# Memory v2 (docs/memory-v2.md): on | off.
MEMORY_V2={{ agentd_memory_v2 }}
DESKTOP_NAME={{ agentd_desktop_name }}
# The model key, and the apps' APNs key if set up, are in
# /etc/agentd/secrets.env (TOGETHER_API_KEY; APNS_AUTH_KEY, APNS_KEY_ID, APNS_TEAM_ID).
# The shell user's commands go out only through the local egress proxy.
SHELL_PROXY=http://127.0.0.1:{{ agentd_egress_proxy_port }}
# The sites the user allows in the app (applied by the privileged helper),
# and the deployment's own list, shown next to them.
EGRESS_USER_HOSTS={{ agentd_egress_user_hosts }}
EGRESS_BASE_HOSTS={{ (agentd_shell_allowed_domains + agentd_shell_extra_domains) | join(' ') }}
# Native apps through the desktop broker (docs/desktop-apps.md): on | off.
DESKTOP_APPS={{ 'on' if agentd_desktop_apps | bool else 'off' }}
DESKTOP_BROKER={{ agentd_desktop_broker_socket }}
