# {{ ansible_managed }}
[Unit]
Description=agentd: the agent on this desktop (model loop, browser and shell tools, chat API)
Wants=network-online.target chrome.service
BindsTo=neo-agent-guard.service
After=network-online.target chrome.service neo-agent-guard.service
StartLimitIntervalSec=0

[Service]
User=agentd
Group=agentd
# /run/agentd/agentd.sock: group agentd (tailnet-proxy) only.
RuntimeDirectory=agentd
RuntimeDirectoryMode=0750
Environment=RUST_LOG=agentd=info
ExecStart=/usr/local/bin/agentd
Restart=always
RestartSec=5
# Shell units start through the fixed root-owned helper. sudo needs to gain privileges.
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
