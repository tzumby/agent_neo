# {{ ansible_managed }}
TELEGRAM_BOT_TOKEN={{ lookup('amazon.aws.ssm_parameter', ssm ~ '/telegram/bot_token', region=desktop_agent_ssm_region) }}
TELEGRAM_ALLOWED_USERS={{ lookup('amazon.aws.ssm_parameter', ssm ~ '/telegram/allowed_users', region=desktop_agent_ssm_region, on_missing='skip') | default('', true) }}
TOGETHER_API_KEY={{ lookup('amazon.aws.ssm_parameter', ssm ~ '/llm/together_api_key', region=desktop_agent_ssm_region) }}
MODEL={{ desktop_agent_model }}
CDP_URL=http://127.0.0.1:9222
WORKDIR={{ desktop_agent_workdir }}
SHELL_TOOL={{ desktop_agent_shell_tool }}
MAX_STEPS={{ desktop_agent_max_steps }}
