{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NothingFromOutsideTheOrganization",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["sts:AssumeRole", "s3:*", "kms:*", "secretsmanager:*", "sqs:*"],
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": { "aws:PrincipalOrgID": "o-REPLACE-WITH-YOUR-ORG-ID" },
        "BoolIfExists": { "aws:PrincipalIsAWSService": "false" }
      }
    }
  ]
}
