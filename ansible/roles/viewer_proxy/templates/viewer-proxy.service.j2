# {{ ansible_managed }}
[Unit]
Description=noVNC viewer on the tailnet (viewer-proxy)
Wants=network-online.target novnc.service
After=network-online.target novnc.service
StartLimitIntervalSec=0

[Service]
User=viewer-proxy
EnvironmentFile=/etc/viewer-proxy.env
ExecStart=/usr/local/bin/viewer-proxy -hostname {{ viewer_proxy_hostname }} -state-dir /var/lib/viewer-proxy -target {{ viewer_proxy_target }}{% if viewer_proxy_allow %} -allow {{ viewer_proxy_allow }}{% endif %}

Restart=always
RestartSec=5
# It only needs the network and its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/viewer-proxy
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
