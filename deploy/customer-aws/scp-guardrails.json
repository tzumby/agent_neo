{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheAgentsRegion",
      "Effect": "Deny",
      "NotAction": [
        "iam:*", "sts:*", "organizations:*", "account:*", "support:*", "health:*",
        "budgets:*", "ce:*", "cur:*", "sso:*", "identitystore:*", "route53:*",
        "cloudfront:*", "waf:*", "shield:*", "globalaccelerator:*", "trustedadvisor:*"
      ],
      "Resource": "*",
      "Condition": { "StringNotEquals": { "aws:RequestedRegion": "ca-central-1" } }
    },
    {
      "Sid": "AuditStaysOn",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:StopLogging", "cloudtrail:DeleteTrail", "cloudtrail:UpdateTrail",
        "cloudtrail:PutEventSelectors", "config:StopConfigurationRecorder",
        "config:DeleteConfigurationRecorder", "config:DeleteDeliveryChannel",
        "guardduty:DeleteDetector", "guardduty:UpdateDetector",
        "guardduty:DisassociateFromAdministratorAccount", "access-analyzer:DeleteAnalyzer"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoLongLivedCredentials",
      "Effect": "Deny",
      "Action": ["iam:CreateUser", "iam:CreateAccessKey", "iam:CreateLoginProfile"],
      "Resource": "*"
    },
    {
      "Sid": "NoConnectionsToOtherNetworks",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateVpcPeeringConnection", "ec2:AcceptVpcPeeringConnection",
        "ec2:CreateTransitGateway*", "ec2:AcceptTransitGateway*", "ec2:AssociateTransitGateway*",
        "ec2:CreateVpnConnection", "ec2:CreateVpnGateway", "ec2:AttachVpnGateway",
        "ec2:CreateCustomerGateway", "ec2:CreateClientVpnEndpoint", "directconnect:*",
        "ram:CreateResourceShare", "ram:AssociateResourceShare", "ram:AcceptResourceShareInvitation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NothingSharedOutOfTheAccount",
      "Effect": "Deny",
      "Action": [
        "ec2:ModifySnapshotAttribute", "ec2:ModifyImageAttribute", "ec2:CreateInstanceExportTask",
        "ec2:ExportImage", "ec2:CreateStoreImageTask", "ec2:DisableImageBlockPublicAccess",
        "ec2:DisableSnapshotBlockPublicAccess", "ebs:GetSnapshotBlock", "ebs:ListSnapshotBlocks",
        "ebs:ListChangedBlocks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoOtherWaysIn",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateKeyPair", "ec2:ImportKeyPair", "ec2:CreateInstanceConnectEndpoint",
        "ec2:EnableSerialConsoleAccess", "ec2-instance-connect:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoPublicAddressesOnInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:network-interface/*",
      "Condition": { "Bool": { "ec2:AssociatePublicIpAddress": "true" } }
    },
    {
      "Sid": "OnlyTheAgentsInstanceTypes",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotEquals": { "ec2:InstanceType": ["t3a.medium", "t3a.large", "t4g.micro", "t4g.xlarge"] }
      }
    },
    {
      "Sid": "TheBoundaryStays",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion", "iam:DeletePolicy", "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "arn:aws:iam::*:policy/cloud-desktops-boundary"
    },
    {
      "Sid": "StayInTheOrganization",
      "Effect": "Deny",
      "Action": "organizations:LeaveOrganization",
      "Resource": "*"
    }
  ]
}
