# {{ ansible_managed }}
[Unit]
Description=agentd: the agent on this desktop (model loop, browser and shell tools, chat API)
Wants=network-online.target chrome.service
After=network-online.target chrome.service
StartLimitIntervalSec=0

[Service]
User=agentd
Group=agentd
# /run/agentd/agentd.sock: group agentd (tailnet-proxy) only.
RuntimeDirectory=agentd
RuntimeDirectoryMode=0750
Environment=RUST_LOG=agentd=info
ExecStart=/usr/local/bin/agentd
Restart=always
RestartSec=5
# The agent's commands run in their own systemd units (sudo systemd-run), not
# in this service, so agentd itself can be confined. No NoNewPrivileges: sudo
# needs it off.
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
