# {{ ansible_managed }}
# Listens on {{ novnc_bind }}: localhost unless a control plane needs to reach
# it (the desktop security group only admits the control plane).
[Unit]
Description=noVNC websocket proxy on :{{ novnc_port }}
Wants=x11vnc.service
After=x11vnc.service
StartLimitIntervalSec=0

[Service]
DynamicUser=yes
ExecStart=/usr/bin/websockify --web /usr/share/novnc {{ novnc_bind }}:{{ novnc_port }} localhost:{{ vnc_port }}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
