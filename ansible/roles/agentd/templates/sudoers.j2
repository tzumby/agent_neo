# {{ ansible_managed }}
# Inputs for these fixed operations arrive on stdin and are validated by the helper.
# No Defaults here: agentd runs sudo without a terminal, so no pty is allocated,
# and Ubuntu 26.04's sudo-rs reads this file too.
Cmnd_Alias NEO_AGENT_HELPER = /usr/local/libexec/neo-agent-privileged run-worker, /usr/local/libexec/neo-agent-privileged stop-worker, /usr/local/libexec/neo-agent-privileged apply-proxy{{ ', /usr/local/libexec/neo-agent-privileged install-snap' if agentd_app_installs | bool else '' }}
agentd ALL=(root) NOPASSWD: NEO_AGENT_HELPER
