# {{ ansible_managed }}
[Unit]
Description=Desktop agent (Telegram bot)
Wants=network-online.target chrome.service
After=network-online.target chrome.service
StartLimitIntervalSec=0

[Service]
User={{ desktop_agent_user }}
WorkingDirectory={{ desktop_agent_workdir }}
# The bot reads its secrets from this file itself; they are not in the
# environment that commands run by the agent inherit.
Environment=DESKTOP_AGENT_CONFIG={{ desktop_agent_config_dir }}/config.env
Environment=PYTHONPATH={{ desktop_agent_dir }} HOME={{ desktop_agent_home }} DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/user/{{ ansible_facts.getent_passwd[desktop_agent_user][1] }}
ExecStart={{ desktop_agent_dir }}/venv/bin/python -m desktop_agent.bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
