# {{ ansible_managed }}
[Unit]
Description=Firewall rules for the desktop (metadata service, desktop controls)
Wants=network-pre.target
Before=network-pre.target agentd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/neo-agent/guard.nft
ExecReload=/usr/sbin/nft -f /etc/neo-agent/guard.nft
ExecStop=/usr/sbin/nft delete table inet neo_agent_guard

[Install]
WantedBy=multi-user.target
