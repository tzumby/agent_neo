# {{ ansible_managed }}
LISTEN=unix:/run/agentd/agentd.sock
MODEL={{ agentd_model }}
CDP_URL=http://127.0.0.1:9222
STATE_DIR=/var/lib/agentd
WORKDIR={{ agentd_workdir }}
RUN_AS={{ agentd_shell_user }}
SHELL_MEMORY_MAX={{ agentd_shell_memory_max }}
SHELL_TASKS_MAX={{ agentd_shell_tasks_max }}
SHELL_CPU_QUOTA={{ agentd_shell_cpu_quota }}
POLICY=/etc/agentd/policy.toml
MAX_STEPS={{ agentd_max_steps }}
SHELL_TOOL={{ agentd_shell_tool }}
DESKTOP_NAME={{ agentd_desktop_name }}
# Push notifications go through the relay (the APNs key never comes here).
PUSH_RELAY_URL={{ lookup('amazon.aws.ssm_parameter', agentd_ssm_prefix ~ '/push/relay_url', region=agentd_ssm_region, on_missing='skip') | default('', true) }}
