#!/usr/bin/python3
"""Fetches a front-door or cloudflared unit's settings from SSM at its start.

Runs as root (ExecStartPre=+): only root and agentd may reach the instance
role's credentials, and the role may read only this desktop's own path,
/front-door/<env>/<desktop> (docs/customer-cloud.md). The customer sets the
parameters there and can change or rotate them at any time; the unit picks
them up at its next start (a reboot restarts both). Until they exist it exits
1 and the unit tries again. Never prints a value.

  front-door-settings front-door  --path /front-door/acme/agent --region ca-central-1
      team_domain, aud and (optional) allow  ->  /run/front-door/access.json
  front-door-settings cloudflared --path ... --region ...
      tunnel_token                           ->  /run/cloudflared/token
"""

import argparse
import json
import os
import pwd
import sys

import boto3
from botocore.exceptions import BotoCoreError, ClientError


def fetch(ssm, path, name, required=True):
    try:
        answer = ssm.get_parameter(Name=f"{path}/{name}", WithDecryption=True)
    except ssm.exceptions.ParameterNotFound:
        if required:
            raise SystemExit(f"waiting for {path}/{name} in SSM (docs/customer-cloud.md)")
        return ""
    return answer["Parameter"]["Value"].strip()


def write(path, content, owner):
    """Writes the file readable by its unit's user only."""
    user = pwd.getpwnam(owner)
    temp = f"{path}.tmp"
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o400)
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.chown(temp, user.pw_uid, user.pw_gid)
    os.replace(temp, path)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("unit", choices=["front-door", "cloudflared"])
    parser.add_argument("--path", required=True)
    parser.add_argument("--region", required=True)
    args = parser.parse_args()

    ssm = boto3.client("ssm", region_name=args.region)
    try:
        if args.unit == "front-door":
            settings = {
                "team_domain": fetch(ssm, args.path, "team_domain"),
                "aud": fetch(ssm, args.path, "aud"),
                "allow": [e.strip() for e in fetch(ssm, args.path, "allow", required=False).split(",") if e.strip()],
            }
            write("/run/front-door/access.json", json.dumps(settings), "front-door")
            print(f"Access settings for team {settings['team_domain']} ({len(settings['allow'])} allowed entries)")
        else:
            write("/run/cloudflared/token", fetch(ssm, args.path, "tunnel_token"), "cloudflared")
            print("tunnel token in place")
    except (BotoCoreError, ClientError) as error:
        raise SystemExit(f"reading {args.path} from SSM: {error}")


if __name__ == "__main__":
    sys.exit(main())
